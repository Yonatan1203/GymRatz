rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCoachOf(clientUid) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(clientUid)).data.coachId == request.auth.uid;
    }

    // Uses custom claim set by onUserRoleUpdate Cloud Function — no get() cost.
    // Falls back to false for users whose token predates the claim (they
    // re-acquire it on next sign-in or within 1 hour via token refresh).
    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }

    // Returns true when the user's subscription is NOT explicitly blocked.
    // Fail-safe: missing or null subscriptionStatus means the webhook hasn't
    // fired yet (e.g. new users, pre-webhook deploy) — we allow access so
    // they are never accidentally locked out. Only "expired" or "cancelled"
    // explicitly blocks write-heavy premium paths.
    function hasActiveSubscription(uid) {
      let status = get(/databases/$(database)/documents/users/$(uid)).data.subscriptionStatus;
      return status == null || !(status == 'expired' || status == 'cancelled');
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isCoachOf(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'email'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string;
      allow update: if (isOwner(uid) || isCoachOf(uid))
        && request.resource.data.keys().hasAll(['displayName', 'email'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string;
      allow delete: if isOwner(uid);

      match /workouts/{wid} {
        allow read: if isOwner(uid) || isCoachOf(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isCoachOf(uid))
          && (!request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['in_progress', 'completed', 'skipped']);
        allow delete: if isOwner(uid) || isCoachOf(uid);
      }

      match /{subcollection}/{docId} {
        allow read: if isOwner(uid) || isCoachOf(uid) || isAdmin();
        // Write-heavy premium paths (workouts, programs) require an active
        // subscription. The check is fail-safe: missing / null status → allowed.
        allow create, update: if (isOwner(uid) || isCoachOf(uid))
          && (
            !(subcollection == 'workouts' || subcollection == 'programs')
            || hasActiveSubscription(uid)
          );
        allow delete: if isOwner(uid) || isCoachOf(uid);
      }
    }

    match /coaches/{coachUid} {
      allow read: if isOwner(coachUid) || isAdmin();
      allow create, update: if isOwner(coachUid);

      match /clients/{clientUid} {
        allow read: if isOwner(coachUid) || isAdmin();
        allow create, update, delete: if isOwner(coachUid);
      }

      match /invites/{inviteId} {
        allow read: if isOwner(coachUid) || request.auth != null;
        allow create, update, delete: if isOwner(coachUid);
      }

      match /programs/{programId} {
        allow read: if isOwner(coachUid) || isAdmin();
        allow create, update, delete: if isOwner(coachUid);
      }
    }

    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.coachUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'accepted', 'expired']);
      allow update: if request.auth != null
        && resource.data.coachUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'accepted', 'expired']);
      allow delete: if request.auth != null
        && resource.data.coachUid == request.auth.uid;
    }

    match /coach_applications/{uid} {
      allow create: if isOwner(uid)
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'approved', 'rejected']);
      allow read: if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid) || isAdmin())
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'approved', 'rejected']);
    }

    // Community programs are readable by any authenticated user;
    // writes are admin-only (managed via Firebase Console or Admin SDK).
    match /community_programs/{programId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
